/* ==== tokens ==== */
:root{
--font:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
--bg:#F2F2F7;--card:#FFFFFF;--label:#000000;--label2:#6E6E73;--label3:#8E8E93;
--sep:rgba(60,60,67,.29);--tint:#007AFF;--fill:rgba(118,118,128,.12);--active:rgba(0,0,0,.06);
--ok:#34C759;--warn:#FF9F0A;--err:#FF3B30;--seg-on:#fff
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
--bg:#000000;--card:#1C1C1E;--label:#FFFFFF;--label2:#98989D;--label3:#8E8E93;
--sep:rgba(84,84,88,.6);--tint:#0A84FF;--fill:rgba(118,118,128,.24);--active:rgba(255,255,255,.08);--seg-on:#636366
}}
:root[data-theme="dark"]{
--bg:#000000;--card:#1C1C1E;--label:#FFFFFF;--label2:#98989D;--label3:#8E8E93;
--sep:rgba(84,84,88,.6);--tint:#0A84FF;--fill:rgba(118,118,128,.24);--active:rgba(255,255,255,.08);--seg-on:#636366
}
html{color-scheme:light dark}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--label);font-family:var(--font);font-size:17px;line-height:1.35;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;padding:0;cursor:pointer}

/* ==== category colors (precomputed per slug) ==== */
.c-koncert{--c:#c2552b;--cbg:#f6e7e1;--cbg-dark:#4e2e20;--cfg-dark:#da9980}
.c-divadlo{--c:#7b4fa3;--cbg:#ede6f2;--cbg-dark:#3a2c42;--cfg-dark:#b095c8}
.c-film{--c:#2f6fb5;--cbg:#e2ebf5;--cbg-dark:#253547;--cfg-dark:#82a9d3}
.c-vystava{--c:#1f8a80;--cbg:#e0efed;--cbg-dark:#203d38;--cfg-dark:#79b9b3}
.c-deti{--c:#c2438a;--cbg:#f6e5ef;--cbg-dark:#4e293b;--cfg-dark:#da8eb9}
.c-trh{--c:#6a8f1f;--cbg:#eaefe0;--cbg-dark:#353e1d;--cfg-dark:#a6bc79}
.c-sport{--c:#2f7d4f;--cbg:#e2ede6;--cbg-dark:#25392a;--cfg-dark:#82b195}
.c-prednaska{--c:#4d5fb3;--cbg:#e6e9f4;--cbg-dark:#2d3146;--cfg-dark:#949fd1}
.c-slavnost{--c:#c0392b;--cbg:#f6e3e1;--cbg-dark:#4e2620;--cfg-dark:#d98880}
.c-komunita{--c:#8a6d3b;--cbg:#efebe4;--cbg-dark:#3e3525;--cfg-dark:#b9a789}
.c-jine{--c:#6b6a64;--cbg:#eaeae9;--cbg-dark:#363430;--cfg-dark:#a6a6a2}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .pill,:root:not([data-theme="light"]) .chip[data-cat]{background:var(--cbg-dark);color:var(--cfg-dark)}}
:root[data-theme="dark"] .pill,:root[data-theme="dark"] .chip[data-cat]{background:var(--cbg-dark);color:var(--cfg-dark)}

/* ==== components: chips & segmented control ==== */
.chip{flex:0 0 auto;scroll-snap-align:start;height:32px;border-radius:16px;padding:0 12px;font-size:15px;display:inline-flex;align-items:center;gap:4px;background:var(--fill);color:var(--label);white-space:nowrap}
.chip:active{opacity:.6}
.chip.on{background:var(--tint);color:#fff}
.chip .n{opacity:.6;font-size:.85em}
.chip[data-cat]{background:var(--cbg);color:var(--c)}
.chip[data-cat].on{background:var(--c);color:#fff}
.seg{display:inline-flex;background:var(--fill);border-radius:9px;padding:2px}
.seg-btn{height:28px;border-radius:7px;padding:0 10px;font-size:13px;color:var(--label2);display:flex;align-items:center;justify-content:center;gap:4px}
.seg-btn.on{background:var(--seg-on);color:var(--label);box-shadow:0 1px 3px rgba(0,0,0,.12)}
.seg-btn .n{opacity:.6;font-size:.85em}

/* ==== components: grouped list ==== */
.grp{font-size:13px;text-transform:uppercase;color:var(--label2);margin:20px 0 6px;padding:0 16px;letter-spacing:.03em}
.grp:first-child{margin-top:8px}
.grp .n,.grp .aliases{text-transform:none;font-weight:400}
.grp .aliases{color:var(--label3);margin-left:6px}
.grp[data-cat]{color:var(--c)}
:root[data-theme="dark"] .grp[data-cat]{color:var(--cfg-dark)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .grp[data-cat]{color:var(--cfg-dark)}}
.list-card{background:var(--card);border-radius:12px;overflow:hidden}
.row{position:relative;display:flex;align-items:center;gap:12px;min-height:64px;padding:10px 12px 10px 16px}
.row:not(:first-child)::before{content:"";position:absolute;left:16px;right:0;top:0;height:.5px;background:var(--sep)}
a.row:active,.row.tap:active{background:var(--active)}
.content{flex:1;min-width:0}
.title{font-size:17px;font-weight:600;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.title a{text-decoration:none}
.title a:active{opacity:.6}
.meta{font-size:15px;color:var(--label2);display:flex;align-items:center;gap:6px;margin-top:2px;overflow:hidden;white-space:nowrap}
.meta .where{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pill{flex:0 0 auto;font-size:12px;font-weight:600;border-radius:6px;padding:1px 6px;background:var(--cbg,var(--fill));color:var(--c,var(--label2))}
.pill-neutral{background:var(--fill);color:var(--label2)}
.subline{font-size:12px;color:var(--label3);margin-top:2px}
.status-pill{flex:0 0 auto;font-size:12px;font-weight:600;border-radius:999px;padding:3px 9px;white-space:nowrap}
.status-pill.s-ok{background:rgba(52,199,89,.15);color:var(--ok)}
.status-pill.s-fallback{background:rgba(255,159,10,.15);color:var(--warn)}
.status-pill.s-error{background:rgba(255,59,48,.15);color:var(--err)}
.status-pill.s-disabled{background:var(--fill);color:var(--label3)}
.none-row{color:var(--label2);font-size:15px}
.chev{color:var(--label3);font-size:20px;flex:0 0 auto;line-height:1}

/* ==== components: empty state ==== */
.empty{text-align:center;padding:48px 20px}
.empty svg{width:48px;height:48px;color:var(--label3);margin-bottom:12px}
.empty-title{font-size:17px;font-weight:600;color:var(--label)}
.empty-sub{font-size:15px;color:var(--label2);margin-top:4px}

.disclaimer{font-size:12px;color:var(--label3);padding:0 16px;margin:10px 0 0}
