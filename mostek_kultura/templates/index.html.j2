<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kultura kolem Mostku</title>
<meta name="description" content="Kulturní akce v okolí obce Mostek: dnes, zítra, tento týden.">
<style>
:root{--bg:#f7f6f2;--card:#fff;--fg:#1d1d1b;--muted:#6b6a64;--line:#e4e2da;--accent:#b4532a;--accent-bg:#fbeee7;--chip:#ecebe5;--chip-on:#1d1d1b;--chip-on-fg:#fff;--ok:#2f7d4f;--warn:#b07a12;--err:#b23a3a}
@media (prefers-color-scheme:dark){:root{--bg:#161614;--card:#211f1c;--fg:#ecebe5;--muted:#a09e95;--line:#33312c;--accent:#e58a5e;--accent-bg:#3a2519;--chip:#2c2a26;--chip-on:#ecebe5;--chip-on-fg:#161614}}
*{box-sizing:border-box}
html{color-scheme:light dark}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
a{color:inherit}
.wrap{max-width:960px;margin:0 auto;padding:16px}
header{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 16px;margin-bottom:12px}
header h1{font-size:1.5rem;margin:0}
header .sub{color:var(--muted);font-size:.9rem}
.tabs{display:flex;gap:4px;flex-wrap:wrap;border-bottom:1px solid var(--line);margin-bottom:10px}
.tabs button{background:none;border:0;border-bottom:3px solid transparent;padding:8px 12px;font:inherit;font-weight:600;color:var(--muted);cursor:pointer}
.tabs button .n{font-weight:400;font-size:.8em;margin-left:4px;color:var(--muted)}
.tabs button.on{color:var(--fg);border-bottom-color:var(--accent)}
.bar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:6px 0}
.bar .lbl{color:var(--muted);font-size:.8rem;margin-right:2px;min-width:52px}
.chip{background:var(--chip);border:0;border-radius:999px;padding:4px 11px;font:inherit;font-size:.85rem;cursor:pointer;color:var(--fg)}
.chip.on{background:var(--chip-on);color:var(--chip-on-fg)}
.chip .n{opacity:.6;font-size:.8em;margin-left:3px}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.seg button{background:none;border:0;padding:4px 10px;font:inherit;font-size:.85rem;cursor:pointer;color:var(--muted)}
.seg button.on{background:var(--chip-on);color:var(--chip-on-fg)}
h2.grp{font-size:1rem;margin:18px 0 6px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
h2.grp:first-child{margin-top:8px}
.ev{display:grid;grid-template-columns:64px 1fr;gap:4px 12px;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:6px}
.ev.img{grid-template-columns:64px 1fr 64px}
.ev .t{font-variant-numeric:tabular-nums;color:var(--accent);font-weight:600;white-space:nowrap;grid-column:1}
.ev .t small{display:block;color:var(--muted);font-weight:400;font-size:.8em}
.ev .h{font-weight:600;grid-column:2}
.ev .h a{text-decoration:none}
.ev .h a:hover{text-decoration:underline}
.ev .m{color:var(--muted);font-size:.85rem;grid-column:2}
.badge{display:inline-block;background:var(--accent-bg);color:var(--accent);border-radius:6px;padding:0 6px;font-size:.75rem;font-weight:600;margin-right:6px;vertical-align:1px}
.ev .src{color:var(--muted);font-size:.72rem;opacity:.7;grid-column:2}
.ev img{grid-column:3;grid-row:1/4;width:64px;height:64px;object-fit:cover;border-radius:6px;background:var(--chip)}
.empty{color:var(--muted);padding:24px 0;text-align:center}
details.ongoing{margin-top:14px}
details.ongoing summary{cursor:pointer;color:var(--muted);font-weight:600}
footer{margin-top:28px;border-top:1px solid var(--line);padding-top:10px;color:var(--muted);font-size:.8rem}
footer table{border-collapse:collapse;margin-top:6px}
footer td{padding:2px 10px 2px 0}
.s-ok{color:var(--ok)}.s-fallback{color:var(--warn)}.s-error{color:var(--err)}
body.embed{font-size:13px}
body.embed .wrap{padding:6px 8px}
body.embed header,body.embed footer,body.embed .ev img{display:none}
body.embed .ev,body.embed .ev.img{padding:6px 8px;margin-bottom:4px;grid-template-columns:52px 1fr}
body.embed .src{display:none}
@media (max-width:480px){.ev,.ev.img{grid-template-columns:56px 1fr}.ev img{display:none}}
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1>Kultura kolem Mostku</h1>
  <span class="sub">Aktualizováno <span id="gen"></span> · <span id="total"></span> akcí v příštích týdnech</span>
</header>
<nav class="tabs" id="tabs"></nav>
<div class="bar" id="cats"><span class="lbl">Typ</span></div>
<div class="bar" id="places"><span class="lbl">Místo</span></div>
<div class="bar"><span class="lbl">Seskupit</span><span class="seg" id="group"></span></div>
<main id="list"></main>
<footer>
  <div>Zdroje: automaticky stahováno jednou denně. Časy a místa ověřte u pořadatele.</div>
  <table>
  {% for s in status.sources %}
    <tr><td>{{ s.name }}</td><td class="s-{{ s.status }}">{{ {'ok':'OK','fallback':'záložní data','error':'chyba','disabled':'vypnuto'}[s.status] }}</td><td>{{ s.count }} akcí</td><td>{{ (s.fetched_at or '')[:16].replace('T',' ') }}</td></tr>
  {% endfor %}
  </table>
</footer>
</div>
<script type="application/json" id="data">{{ data_json|safe }}</script>
<script>
(function(){
const D=JSON.parse(document.getElementById('data').textContent);
const TZ=D.tz||'Europe/Prague';
const qs=new URLSearchParams(location.search);
const embed=qs.get('embed')==='1'||location.hash.includes('embed');
if(embed)document.body.classList.add('embed');
const fmtDate=d=>d.toLocaleDateString('sv-SE',{timeZone:TZ});
const today=fmtDate(new Date());
const addDays=(iso,n)=>{const d=new Date(iso+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+n);return d.toISOString().slice(0,10)};
const dow=iso=>(new Date(iso+'T12:00:00Z').getUTCDay()+6)%7; // 0=Mon
const wd=dow(today);
const satOff=5-wd; // negative on Sunday -> this weekend
const weekend=[addDays(today,satOff),addDays(today,satOff+1)];
const TABS=[['today','Dnes',[today,today]],['tomorrow','Zítra',[addDays(today,1),addDays(today,1)]],['weekend','Víkend',weekend],['week','Týden',[today,addDays(today,6)]],['all','Vše',[today,'9999']]];
const GROUPS=[['day','podle dne'],['category','podle typu'],['place','podle místa']];
const CAT=Object.fromEntries(D.categories.map(c=>[c.slug,c.label]));
D.events.forEach(e=>{e.sd=fmtDate(new Date(e.start));e.ed=e.end?fmtDate(new Date(e.end)):e.sd;e.time=e.all_day?null:new Date(e.start).toLocaleTimeString('cs-CZ',{timeZone:TZ,hour:'2-digit',minute:'2-digit'})});
document.getElementById('gen').textContent=new Date(D.generated_at).toLocaleString('cs-CZ',{timeZone:TZ,day:'numeric',month:'numeric',hour:'2-digit',minute:'2-digit'});
document.getElementById('total').textContent=D.events.length;

// state from hash
const st={tab:qs.get('tab')||'week',cat:new Set(),place:new Set(),group:qs.get('group')||'day'};
function readHash(){const h=new URLSearchParams(location.hash.replace(/^#/,''));if(h.get('tab'))st.tab=h.get('tab');if(h.get('group'))st.group=h.get('group');st.cat=new Set((h.get('cat')||'').split(',').filter(Boolean));st.place=new Set((h.get('place')||'').split(',').filter(Boolean))}
function writeHash(){const h=new URLSearchParams();h.set('tab',st.tab);if(st.group!=='day')h.set('group',st.group);if(st.cat.size)h.set('cat',[...st.cat].join(','));if(st.place.size)h.set('place',[...st.place].join(','));if(embed)h.set('embed','1');history.replaceState(null,'','#'+h.toString())}
readHash();
if(!TABS.some(t=>t[0]===st.tab))st.tab='week';

function inRange(e,r){if(e.ongoing)return e.sd<=r[1]&&e.ed>=r[0];return e.sd>=r[0]&&e.sd<=r[1]}
function startsIn(e,r){return e.sd>=r[0]&&e.sd<=r[1]}
function filt(e){return (!st.cat.size||st.cat.has(e.category))&&(!st.place.size||st.place.has(e.place||'?'))}
const dayLabel=iso=>{const d=new Date(iso+'T12:00:00Z');const s=d.toLocaleDateString('cs-CZ',{weekday:'long',day:'numeric',month:'long',timeZone:'UTC'});return iso===today?'Dnes · '+s:iso===addDays(today,1)?'Zítra · '+s:s};
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

function evHtml(e,showDate){
  const when=e.ongoing?`<span class="t">do<small>${esc(e.ed.split('-').reverse().slice(0,2).join('. '))}.</small></span>`:`<span class="t">${e.time||'celý den'}${showDate?`<small>${esc(e.sd.split('-').reverse().slice(0,2).join('. '))}.</small>`:''}</span>`;
  const img=!embed&&e.image?`<img src="${esc(e.image)}" alt="" loading="lazy">`:'';
  const where=[e.place,e.venue&&e.venue!==e.place?e.venue:null].filter(Boolean).join(' · ');
  return `<div class="ev${img?' img':''}">${when}<div class="h">${e.url?`<a href="${esc(e.url)}" target="_blank" rel="noopener">${esc(e.title)}</a>`:esc(e.title)}</div><div class="m"><span class="badge">${esc(CAT[e.category]||e.category)}</span>${esc(where)}</div><div class="src">${esc(e.sources.join(', '))}</div>${img}</div>`;
}
function render(){
  const tab=TABS.find(t=>t[0]===st.tab);const r=tab[2];
  const all=D.events.filter(filt);
  const main=all.filter(e=>startsIn(e,r)||(e.ongoing&&st.tab==='all'));
  const ongoing=st.tab==='all'?[]:all.filter(e=>e.ongoing&&!startsIn(e,r)&&inRange(e,r));
  // tabs
  document.getElementById('tabs').innerHTML=TABS.map(t=>{const n=D.events.filter(filt).filter(e=>startsIn(e,t[2])||(t[0]==='all'&&e.ongoing)).length;return `<button data-tab="${t[0]}" class="${t[0]===st.tab?'on':''}">${t[1]}<span class="n">${n}</span></button>`}).join('');
  // chips (counts within current tab, ignoring the chip's own filter)
  const inTab=D.events.filter(e=>startsIn(e,r)||(st.tab==='all'&&e.ongoing));
  const cc={},pc={};inTab.forEach(e=>{if(!st.place.size||st.place.has(e.place||'?'))cc[e.category]=(cc[e.category]||0)+1;if(!st.cat.size||st.cat.has(e.category))pc[e.place||'?']=(pc[e.place||'?']||0)+1});
  document.getElementById('cats').innerHTML='<span class="lbl">Typ</span>'+D.categories.filter(c=>cc[c.slug]||st.cat.has(c.slug)).map(c=>`<button class="chip ${st.cat.has(c.slug)?'on':''}" data-cat="${c.slug}">${c.label}<span class="n">${cc[c.slug]||0}</span></button>`).join('');
  const places=Object.keys(pc).sort((a,b)=>pc[b]-pc[a]);[...st.place].forEach(p=>{if(!places.includes(p))places.push(p)});
  document.getElementById('places').innerHTML='<span class="lbl">Místo</span>'+places.map(p=>`<button class="chip ${st.place.has(p)?'on':''}" data-place="${esc(p)}">${esc(p==='?'?'neurčeno':p)}<span class="n">${pc[p]||0}</span></button>`).join('');
  document.getElementById('group').innerHTML=GROUPS.map(g=>`<button data-group="${g[0]}" class="${g[0]===st.group?'on':''}">${g[1]}</button>`).join('');
  // list
  const key=e=>st.group==='day'?e.sd:st.group==='category'?e.category:(e.place||'?');
  const label=k=>st.group==='day'?dayLabel(k):st.group==='category'?(CAT[k]||k):(k==='?'?'Místo neurčeno':k);
  const groups={};main.forEach(e=>{(groups[key(e)]=groups[key(e)]||[]).push(e)});
  let keys=Object.keys(groups);
  if(st.group==='category')keys.sort((a,b)=>D.categories.findIndex(c=>c.slug===a)-D.categories.findIndex(c=>c.slug===b));else if(st.group==='place')keys.sort((a,b)=>groups[b].length-groups[a].length);else keys.sort();
  let html=keys.map(k=>`<h2 class="grp">${esc(label(k))}</h2>`+groups[k].sort((a,b)=>a.start<b.start?-1:1).map(e=>evHtml(e,st.group!=='day')).join('')).join('');
  if(!main.length)html='<div class="empty">Žádné akce.</div>';
  if(ongoing.length)html+=`<details class="ongoing"${embed?'':' open'}><summary>Probíhající výstavy a vícedenní akce (${ongoing.length})</summary>${ongoing.map(e=>evHtml(e,false)).join('')}</details>`;
  document.getElementById('list').innerHTML=html;
  writeHash();
}
document.addEventListener('click',ev=>{
  const b=ev.target.closest('button');if(!b)return;
  if(b.dataset.tab){st.tab=b.dataset.tab}
  else if(b.dataset.cat){st.cat.has(b.dataset.cat)?st.cat.delete(b.dataset.cat):st.cat.add(b.dataset.cat)}
  else if(b.dataset.place){st.place.has(b.dataset.place)?st.place.delete(b.dataset.place):st.place.add(b.dataset.place)}
  else if(b.dataset.group){st.group=b.dataset.group}
  else return;
  render();
});
render();
})();
</script>
</body>
</html>
