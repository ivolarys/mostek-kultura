<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png?v=mostkultura-1">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Zdroje podle obce · Mostkultura</title>
<link rel="icon" href="icon.svg?v=mostkultura-1" type="image/svg+xml">
<style>
{% include "_base.css.j2" %}
/* ==== layout ==== */
.wrap{max-width:900px;margin:0 auto;padding:0 20px 38px}
.navbar{display:flex;align-items:center;min-height:56px;padding:0 12px;position:sticky;top:0;z-index:10;background:rgba(251,247,241,.92);-webkit-backdrop-filter:saturate(170%) blur(18px);backdrop-filter:saturate(170%) blur(18px);border-bottom:1px solid var(--sep);margin:0 -20px}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .navbar{background:rgba(22,16,29,.91)}}
:root[data-theme="dark"] .navbar{background:rgba(22,16,29,.91)}
.navbar .back{color:var(--tint);font-size:15px;font-weight:700;flex:0 0 auto;min-height:44px;display:flex;align-items:center;gap:4px;padding:0 6px;border-radius:10px}
.navbar .back:hover{background:var(--active)}
.navbar .back .icon{width:19px;height:19px}
.navbar h1{font-size:17px;font-weight:750;margin:0;flex:1;text-align:center;padding-right:76px}
.page-head{padding:28px 2px 8px}
.eyebrow{display:flex;align-items:center;gap:7px;color:var(--label);font-size:16px;text-transform:none;letter-spacing:0;font-weight:800}
.eyebrow-logo{width:24px;height:22px;display:block;object-fit:contain}
.eyebrow .icon{width:19px;height:19px}
.page-head h2{font-size:34px;line-height:1.04;letter-spacing:-.035em;margin:13px 0 8px}
.sub{font-size:12px;color:var(--label3);margin:0}
.intro{color:var(--label2);font-size:15px;max-width:680px;margin:0 0 8px}
.src-row{align-items:flex-start}
.src-row .status-pill{margin-top:2px}
.src-icon{width:36px;height:36px;flex:0 0 36px;border-radius:10px;background:var(--fill);color:var(--label2);display:flex;align-items:center;justify-content:center;margin-top:1px}
.src-icon .icon{width:19px;height:19px}
.src-row .meta{flex-wrap:wrap;white-space:normal}
.src-row .title a:hover{color:var(--tint)}
.disclaimer a{color:var(--tint);text-decoration:underline;text-underline-offset:2px}
code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.95em}
@media (min-width:700px){.wrap{padding:0 28px 42px}.navbar{margin:0 -28px}.page-head{padding-top:38px}.page-head h2{font-size:44px}.grp .aliases{display:inline;margin-left:7px}}
</style>
</head>
<body>
<div class="wrap">
<nav class="navbar"><a class="back" href="./"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>Přehled</a><h1>Zdroje</h1></nav>
<header class="page-head">
  <div class="eyebrow"><img class="eyebrow-logo" src="logo.svg?v=mostkultura-1" alt="">Mostkultura</div>
  <h2>Odkud akce bereme</h2>
  <p class="intro">U každé obce vidíte pokryté weby, výsledek posledního stažení a počet aktuálních akcí. Obce bez vlastního zdroje doplňují regionální kalendáře.</p>
  <p class="sub">Aktualizováno {{ generated_at[:16].replace('T',' ') }}</p>
</header>

{% for g in groups %}
<h2 class="grp">{{ g.place }}<span class="n"> · {{ g.event_count|akce }} v přehledu</span>{% if g.aliases %}<span class="aliases">také: {{ g.aliases|join(', ') }}</span>{% endif %}</h2>
<div class="list-card">
{% for s in g.sources %}
<div class="row src-row">
  <span class="src-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"/></svg></span>
  <div class="content">
    <div class="title"><a href="{{ s.page }}" target="_blank" rel="noopener">{{ s.title }}</a></div>
    <div class="meta"><span class="pill pill-neutral">{{ s.type }}</span>{{ s.host }}{% if s.covers %} · pokrývá: {{ s.covers|join(', ') }}{% endif %}</div>
    <div class="subline">{{ s.count|akce }} · {{ s.fetched }}</div>
  </div>
  <span class="status-pill s-{{ s.status }}">{{ s.status_label }}</span>
</div>
{% else %}
<div class="row none-row">Zatím bez vlastního zdroje – akce jen z regionálních zdrojů níže.</div>
{% endfor %}
</div>
{% endfor %}

<h2 class="grp">Regionální zdroje<span class="n"> · více obcí</span></h2>
<div class="list-card">
{% for s in regional %}
<div class="row src-row">
  <span class="src-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"/></svg></span>
  <div class="content">
    <div class="title"><a href="{{ s.page }}" target="_blank" rel="noopener">{{ s.title }}</a></div>
    <div class="meta"><span class="pill pill-neutral">{{ s.type }}</span>{{ s.host }}{% if s.covers %} · pokrývá: {{ s.covers|join(', ') }}{% endif %}</div>
    <div class="subline">{{ s.count|akce }} · {{ s.fetched }}</div>
  </div>
  <span class="status-pill s-{{ s.status }}">{{ s.status_label }}</span>
</div>
{% endfor %}
</div>

{% if venues_allow %}
<h2 class="grp">Konkrétní místa mimo seznam obcí</h2>
<div class="list-card"><div class="row none-row">Vždy zobrazená venue: {{ venues_allow|join(', ') }}</div></div>
{% endif %}

<p class="disclaimer">Chceš přidat obec nebo zdroj? Stačí upravit <code>config.yaml</code> v repozitáři <a href="https://github.com/ivolarys/mostkultura">ivolarys/mostkultura</a>.</p>
</div>
</body>
</html>
