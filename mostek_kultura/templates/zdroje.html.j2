<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Zdroje podle obce · Kultura kolem Mostku</title>
<link rel="icon" href="icon.svg" type="image/svg+xml">
<style>
{% include "_base.css.j2" %}
/* ==== layout ==== */
.wrap{max-width:720px;margin:0 auto;padding:0 16px 32px}
.navbar{display:flex;align-items:center;height:44px;padding:0 12px;position:sticky;top:0;z-index:10;background:rgba(242,242,247,.85);-webkit-backdrop-filter:saturate(180%) blur(20px);backdrop-filter:saturate(180%) blur(20px);border-bottom:.5px solid var(--sep);margin:0 -16px}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .navbar{background:rgba(0,0,0,.8)}}
:root[data-theme="dark"] .navbar{background:rgba(0,0,0,.8)}
.navbar .back{color:var(--tint);font-size:17px;flex:0 0 auto;padding:8px 6px 8px 0}
.navbar .back:active{opacity:.6}
.navbar h1{font-size:17px;font-weight:600;margin:0;flex:1;text-align:center;padding-right:52px}
.sub{font-size:13px;color:var(--label3);padding:8px 16px 0}
.intro{color:var(--label2);font-size:15px;padding:6px 16px 0;margin:0}
.src-row{align-items:flex-start}
.src-row .status-pill{margin-top:2px}
@media (min-width:700px){.wrap{padding:0 24px 32px}.navbar{margin:0 -24px}}
</style>
</head>
<body>
<div class="wrap">
<nav class="navbar"><a class="back" href="./">‹ Přehled</a><h1>Zdroje podle obce</h1></nav>
<p class="sub">aktualizováno {{ generated_at[:16].replace('T',' ') }}</p>
<p class="intro">Odkud se akce berou. U každé obce je vidět, které weby ji pokrývají, jak dopadlo poslední stažení a kolik akcí z ní je aktuálně v přehledu. Obce bez vlastního zdroje dostávají akce jen z regionálních zdrojů (GoOut, „Akce v okolí“ na webu Mostku).</p>

{% for g in groups %}
<h2 class="grp">{{ g.place }}<span class="n"> · {{ g.event_count|akce }} v přehledu</span>{% if g.aliases %}<span class="aliases">také: {{ g.aliases|join(', ') }}</span>{% endif %}</h2>
<div class="list-card">
{% for s in g.sources %}
<div class="row src-row">
  <div class="content">
    <div class="title"><a href="{{ s.page }}" target="_blank" rel="noopener">{{ s.title }}</a></div>
    <div class="meta"><span class="pill pill-neutral">{{ s.type }}</span>{{ s.host }}{% if s.covers %} · pokrývá: {{ s.covers|join(', ') }}{% endif %}</div>
    <div class="subline">{{ s.count|akce }} · {{ s.fetched }}</div>
  </div>
  <span class="status-pill s-{{ s.status }}">{{ s.status_label }}</span>
</div>
{% else %}
<div class="row none-row">Zatím bez vlastního zdroje – akce jen z regionálních zdrojů níže.</div>
{% endfor %}
</div>
{% endfor %}

<h2 class="grp">Regionální zdroje<span class="n"> · více obcí</span></h2>
<div class="list-card">
{% for s in regional %}
<div class="row src-row">
  <div class="content">
    <div class="title"><a href="{{ s.page }}" target="_blank" rel="noopener">{{ s.title }}</a></div>
    <div class="meta"><span class="pill pill-neutral">{{ s.type }}</span>{{ s.host }}{% if s.covers %} · pokrývá: {{ s.covers|join(', ') }}{% endif %}</div>
    <div class="subline">{{ s.count|akce }} · {{ s.fetched }}</div>
  </div>
  <span class="status-pill s-{{ s.status }}">{{ s.status_label }}</span>
</div>
{% endfor %}
</div>

{% if venues_allow %}
<h2 class="grp">Konkrétní místa mimo seznam obcí</h2>
<div class="list-card"><div class="row none-row">Vždy zobrazená venue: {{ venues_allow|join(', ') }}</div></div>
{% endif %}

<p class="disclaimer">Chceš přidat obec nebo zdroj? Stačí upravit <code>config.yaml</code> v repozitáři <a href="https://github.com/ivolarys/mostek-kultura">ivolarys/mostek-kultura</a>.</p>
</div>
</body>
</html>
